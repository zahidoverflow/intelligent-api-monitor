{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/monitor/(.*)", "destination": "/api/index.js" },
    { "source": "/monitor", "destination": "/api/index.js" },
    { "source": "/alerts/(.*)", "destination": "/api/index.js" },
    { "source": "/alerts", "destination": "/api/index.js" },
    { "source": "/metrics/(.*)", "destination": "/api/index.js" },
    { "source": "/metrics", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ]
}
